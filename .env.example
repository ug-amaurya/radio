# Audius app credentials (Audius API Plans / developer settings)
AUDIUS_API_KEY=
# Server only - never expose to the browser
AUDIUS_BEARER_TOKEN=
AUDIUS_REDIRECT_URI=http://localhost:5173/callback

# Session secret
SESSION_SECRET=

# Postgres (local via infra/docker-compose.yml)
DATABASE_URL=postgresql://audius_radio:audius_radio@localhost:5432/audius_radio

# Redis (local via infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Optional: error reporting (leave empty to disable)
SENTRY_DSN=

# Frontend (Vite exposes only VITE_-prefixed vars to client code)
VITE_AUDIUS_API_KEY=
VITE_AUDIUS_REDIRECT_URI=http://localhost:5173/callback
VITE_AUDIUS_API_KEY=
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Only if the API is on a different domain than the site (production): the websocket host.
# VITE_SOCKET_URL=https://audius-radio-api.onrender.com
VITE_SENTRY_DSN=
